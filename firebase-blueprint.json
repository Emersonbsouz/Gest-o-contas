{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "Uma empresa ou perfil financeiro isolado (pessoal ou PJ) com controle de membros e acessos.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["personal", "business"] },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "memberEmails": { "type": "array" },
        "membersInfo": { "type": "array" },
        "createdAt": { "type": "number" },
        "color": { "type": "string" }
      },
      "required": ["id", "name", "type", "ownerId", "ownerEmail", "memberEmails"]
    },
    "TreasuryAccount": {
      "title": "TreasuryAccount",
      "description": "Conta bancária ou caixa financeiro pertencente à empresa ou perfil.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["checking", "cash", "savings", "investment"] },
        "initialBalance": { "type": "number" },
        "color": { "type": "string" },
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" }
      },
      "required": ["id", "name", "type", "initialBalance", "color"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Registro de despesa financeira da empresa.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "categoryId": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "accountId": { "type": "string" },
        "cardId": { "type": "string" },
        "contactId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "description", "amount", "date", "categoryId", "paymentMethod"]
    },
    "Income": {
      "title": "Income",
      "description": "Receita ou faturamento da empresa.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "accountId": { "type": "string" },
        "category": { "type": "string" },
        "contactId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "description", "amount", "date", "accountId", "category"]
    },
    "CreditCard": {
      "title": "CreditCard",
      "description": "Cartão de crédito corporativo ou pessoal.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "limit": { "type": "number" },
        "closingDay": { "type": "number" },
        "dueDay": { "type": "number" },
        "color": { "type": "string" }
      },
      "required": ["id", "name", "brand", "limit", "closingDay", "dueDay", "color"]
    },
    "Category": {
      "title": "Category",
      "description": "Categoria de plano de contas ou despesas.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["id", "name", "color", "icon"]
    },
    "ContactPerson": {
      "title": "ContactPerson",
      "description": "Cliente, fornecedor ou parceiro comercial.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "document": { "type": "string" }
      },
      "required": ["id", "name", "type"]
    },
    "RecurringBill": {
      "title": "RecurringBill",
      "description": "Conta fixa recorrente a pagar ou receber.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "dueDay": { "type": "number" },
        "categoryId": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "description", "type", "amount", "dueDay", "categoryId", "active"]
    },
    "AccountTransfer": {
      "title": "AccountTransfer",
      "description": "Transferência de saldo entre contas da mesma empresa.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fromAccountId": { "type": "string" },
        "toAccountId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "fromAccountId", "toAccountId", "amount", "date"]
    },
    "FinancialGoal": {
      "title": "FinancialGoal",
      "description": "Meta ou reserva financeira da empresa/perfil.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "color": { "type": "string" }
      },
      "required": ["id", "title", "targetAmount", "currentAmount", "color"]
    }
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Documentos de empresas com lista de membros autorizados."
    },
    "/companies/{companyId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/TreasuryAccount" },
      "description": "Contas da empresa."
    },
    "/companies/{companyId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Despesas da empresa."
    },
    "/companies/{companyId}/incomes/{incomeId}": {
      "schema": { "$ref": "#/entities/Income" },
      "description": "Receitas da empresa."
    },
    "/companies/{companyId}/cards/{cardId}": {
      "schema": { "$ref": "#/entities/CreditCard" },
      "description": "Cartões da empresa."
    },
    "/companies/{companyId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Categorias de despesa da empresa."
    },
    "/companies/{companyId}/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/ContactPerson" },
      "description": "Contatos e fornecedores da empresa."
    },
    "/companies/{companyId}/recurring/{recurringId}": {
      "schema": { "$ref": "#/entities/RecurringBill" },
      "description": "Contas recorrentes da empresa."
    },
    "/companies/{companyId}/transfers/{transferId}": {
      "schema": { "$ref": "#/entities/AccountTransfer" },
      "description": "Transferências financeiras da empresa."
    },
    "/companies/{companyId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/FinancialGoal" },
      "description": "Metas da empresa."
    }
  }
}
