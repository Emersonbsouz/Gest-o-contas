rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function companyPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId);
    }

    function companyExists(companyId) {
      return exists(companyPath(companyId));
    }

    function getCompany(companyId) {
      return get(companyPath(companyId)).data;
    }

    function isCompanyOwner(companyId) {
      return isSignedIn()
        && companyExists(companyId)
        && (
          getCompany(companyId).ownerId == request.auth.uid
          || getCompany(companyId).ownerEmail.lower() == getUserEmail()
        );
    }

    function isCompanyMember(companyId) {
      return isSignedIn()
        && companyExists(companyId)
        && (
          getCompany(companyId).ownerId == request.auth.uid
          || getCompany(companyId).ownerEmail.lower() == getUserEmail()
          || getUserEmail() in getCompany(companyId).memberEmails
        );
    }

    function isValidCompany(data) {
      return data.keys().hasAll([
          'id',
          'name',
          'type',
          'ownerId',
          'ownerEmail',
          'memberEmails',
          'createdAt'
        ])
        && data.id is string
        && data.id.size() <= 100
        && data.name is string
        && data.name.size() <= 100
        && data.type in ['personal', 'business']
        && data.ownerId == request.auth.uid
        && data.ownerEmail.lower() == getUserEmail()
        && data.memberEmails is list
        && getUserEmail() in data.memberEmails
        && data.createdAt is number;
    }

    function isValidExpense(data) {
      return data.keys().hasAll([
          'id',
          'description',
          'amount',
          'date',
          'categoryId',
          'paymentMethod'
        ])
        && data.id is string
        && data.id.size() <= 100
        && data.description is string
        && data.description.size() <= 200
        && data.amount is number
        && data.amount >= 0
        && data.date is string
        && data.date.size() <= 10
        && data.categoryId is string
        && data.paymentMethod is string;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /companies/{companyId} {
      allow read: if isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || resource.data.ownerEmail.lower() == getUserEmail()
          || getUserEmail() in resource.data.memberEmails
        );

      allow create: if isSignedIn() && isValidCompany(request.resource.data);

      allow update: if isCompanyOwner(companyId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.id == resource.data.id;

      allow delete: if isCompanyOwner(companyId);

      match /expenses/{docId} {
        allow read: if isCompanyMember(companyId);
        allow create, update: if isCompanyMember(companyId)
          && isValidExpense(request.resource.data);
        allow delete: if isCompanyMember(companyId);
      }

      match /{subcollection}/{docId} {
        allow read, write: if subcollection != 'expenses'
          && isCompanyMember(companyId);
      }
    }
  }
}
