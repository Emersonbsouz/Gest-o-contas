rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserEmail() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Companies collection - persisted in Cloud Firestore
    match /companies/{companyId} {
      allow read, write: if true;

      // Subcollections belonging to the company (expenses, accounts, cards, categories, contacts, etc.)
      match /{subcollection}/{docId} {
        allow read, write: if true;
      }
    }
  }
}


